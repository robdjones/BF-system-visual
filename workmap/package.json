{
  "name": "workmap-monorepo",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w apps/dev",
    "build": "npm run build -w packages/core && npm run build -w apps/dev",
    "typecheck": "tsc -b packages/core packages/react apps/dev",
    "test": "node --test --import tsx packages/core/test/*.test.ts",
    "export": "node packages/export/export.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
